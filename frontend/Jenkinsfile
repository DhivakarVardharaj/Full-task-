pipeline {

    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')

        S3_BUCKET = 'smart-task-frontend-960328031069'

        CLOUDFRONT_ID = 'E2Y4RT58XD0A6J'

        WEBSITE_URL = 'https://dpx4o2gj4f8uy.cloudfront.net'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Smart Task Management System'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Frontend Tests') {
            steps {
                dir('frontend') {
                    sh '''
                        if node -e "process.exit(require('./package.json').scripts?.test ? 0 : 1)"; then
                            npm test -- --run
                        else
                            echo "No frontend test script configured. Skipping tests."
                        fi
                    '''
                }
            }
        }

        stage('Build React Application') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Verify Build') {
            steps {
                dir('frontend') {
                    sh '''
                        test -f dist/index.html
                        echo "Frontend production build verified."
                        ls -lh dist/
                    '''
                }
            }
        }

        stage('AWS Authentication') {
            steps {
                sh '''
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Deploy Frontend to Existing S3') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Deploying frontend to existing S3 bucket..."

                        aws s3 sync dist/ s3://${S3_BUCKET}/ \
                            --delete \
                            --cache-control "public,max-age=31536000,immutable" \
                            --exclude "index.html"

                        aws s3 cp dist/index.html s3://${S3_BUCKET}/index.html \
                            --cache-control "no-cache,no-store,must-revalidate" \
                            --content-type "text/html"

                        echo "Frontend uploaded successfully."
                    '''
                }
            }
        }

        stage('CloudFront Cache Invalidation') {
            steps {
                sh '''
                    echo "Invalidating existing CloudFront distribution..."

                    aws cloudfront create-invalidation \
                        --distribution-id ${CLOUDFRONT_ID} \
                        --paths "/*"

                    echo "CloudFront invalidation requested."
                '''
            }
        }

        stage('Deployment Summary') {
            steps {
                echo '========================================'
                echo 'FRONTEND DEPLOYMENT SUCCESSFUL'
                echo '========================================'
                echo "Website URL: ${env.WEBSITE_URL}"
                echo "S3 Bucket: ${env.S3_BUCKET}"
                echo "CloudFront ID: ${env.CLOUDFRONT_ID}"
                echo '========================================'
            }
        }
    }

    post {
        success {
            echo 'Smart Task Management frontend deployment completed successfully!'
        }

        failure {
            echo 'Frontend deployment failed. Check Jenkins Console Output.'
        }

        always {
            echo 'Frontend pipeline execution finished.'
        }
    }
}