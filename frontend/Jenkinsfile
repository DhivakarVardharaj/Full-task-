pipeline {

    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'

        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')

        IMAGE_NAME = 'smart-task-frontend'

        TF_IN_AUTOMATION = 'true'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Smart Task Management System'

                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }


        stage('Frontend Tests') {
            steps {
                dir('frontend') {
                    sh '''
                        if node -e "process.exit(require('./package.json').scripts?.test ? 0 : 1)"; then
                            npm test -- --run
                        else
                            echo "No frontend test script configured. Skipping tests."
                        fi
                    '''
                }
            }
        }


        stage('Build React Application') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('frontend') {
                    sh '''
                        docker build \
                        -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                        -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }


        stage('Verify Docker Image') {
            steps {
                sh 'docker images ${IMAGE_NAME}'
            }
        }

        stage('AWS Authentication') {
            steps {
                sh '''
                    aws sts get-caller-identity
                    aws configure get region || true
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }


        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Manual Approval') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: 'Approve creation/update of AWS frontend infrastructure?',
                          ok: 'Approve Deployment'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }


        stage('Get Deployment Details') {
            steps {
                dir('terraform') {
                    script {
                        env.S3_BUCKET = sh(
                            script: 'terraform output -raw s3_bucket_name',
                            returnStdout: true
                        ).trim()

                        env.CLOUDFRONT_ID = sh(
                            script: 'terraform output -raw cloudfront_distribution_id',
                            returnStdout: true
                        ).trim()

                        env.WEBSITE_URL = sh(
                            script: 'terraform output -raw cloudfront_website_url',
                            returnStdout: true
                        ).trim()
                    }
                }

                echo "S3 Bucket: ${env.S3_BUCKET}"
                echo "CloudFront URL: ${env.WEBSITE_URL}"
            }
        }


        stage('Deploy Frontend to S3') {
            steps {
                dir('frontend') {
                    sh '''
                        aws s3 sync dist/ s3://${S3_BUCKET}/ \
                        --delete \
                        --cache-control "public,max-age=31536000,immutable" \
                        --exclude "index.html"

                        aws s3 cp dist/index.html s3://${S3_BUCKET}/index.html \
                        --cache-control "no-cache,no-store,must-revalidate" \
                        --content-type "text/html"
                    '''
                }
            }
        }


        stage('CloudFront Invalidation') {
            steps {
                sh '''
                    aws cloudfront create-invalidation \
                    --distribution-id ${CLOUDFRONT_ID} \
                    --paths "/*"
                '''
            }
        }

        stage('Deployment Summary') {
            steps {
                echo '========================================'
                echo 'FRONTEND DEPLOYMENT SUCCESSFUL'
                echo '========================================'
                echo "Website URL: ${env.WEBSITE_URL}"
                echo "S3 Bucket: ${env.S3_BUCKET}"
                echo '========================================'
            }
        }
    }

    post {
        success {
            echo 'Smart Task Management frontend pipeline completed successfully!'
        }

        failure {
            echo 'Frontend pipeline failed. Check Jenkins Console Output.'
        }

        always {
            echo 'Frontend pipeline execution finished.'
        }
    }
}